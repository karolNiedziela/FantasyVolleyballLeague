<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CA1716: "Shared" is a Visual Basic keyword. The solution is C# only, so no VB consumer is affected. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The projects that create entities ban Guid.NewGuid() (ids are UUID v7 from EntityId); the others may use it. -->
    <AdditionalFiles Include="..\..\BannedSymbols.txt" />
  </ItemGroup>

</Project>
